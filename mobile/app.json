{
  "expo": {
    "name": "NextSet",
    "slug": "nextset",
    "icon": "./assets/nextset-icon.png",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kararmojid.nextset"
    },
    "android": {
      "package": "com.kararmojid.nextset",
      "adaptiveIcon": {
        "foregroundImage": "./assets/nextset-adaptive-foreground.png",
        "backgroundColor": "#F5F0E6",
        "monochromeImage": "./assets/nextset-adaptive-monochrome.png"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing"
    ]
  }
}
